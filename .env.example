# Grocify Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration (must point to exact same database as client)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=Grocify
AUTH_DB_NAME=Grocify

# Client URL (for CORS and JWKS verification)
CLIENT_URL=http://localhost:3000